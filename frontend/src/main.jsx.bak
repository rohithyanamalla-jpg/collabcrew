import React, { useEffect, useMemo, useState } from 'react';
import { createRoot } from 'react-dom/client';
import { LayoutDashboard, Compass, UserRound, PanelsTopLeft, FileText, Handshake, BriefcaseBusiness, ChartNoAxesCombined, Wallet, UsersRound, Bell, Settings, Search, Plus, Sparkles, ArrowUpRight, ChevronDown, Menu, X, Filter, SlidersHorizontal, Clock3, BadgeCheck, Play, Image as ImageIcon, Video, Send, WandSparkles, CheckCircle2, AlertCircle, LogOut, Eye, Trash2, Edit3, CalendarDays, DollarSign, Zap, UploadCloud, MessageCircle, Activity } from 'lucide-react';
import './styles.css';

const API =
  import.meta.env.VITE_API_URL ||
  'https://creovanta-corrected-project-zip-1.onrender.com';
const demoLogins = { creator: 'creator1@demo.creovanta.app', brand: 'brand@demo.creovanta.app', admin: 'admin@demo.creovanta.app' };
const navItems = [
  { label:'Dashboard', icon:LayoutDashboard, group:'WORKSPACE' },
  { label:'Discover Creators', icon:Compass, group:'WORKSPACE' },
  { label:'My Profile', icon:UserRound, group:'CREATE' },
  { label:'AI Portfolio', icon:PanelsTopLeft, group:'CREATE' },
  { label:'Creative Briefs', icon:FileText, group:'WORKSPACE' },
  { label:'Collaboration Hub', icon:Handshake, group:'WORKSPACE' },
  { label:'Brand Deals', icon:BriefcaseBusiness, group:'WORKSPACE' },
  { label:'Analytics', icon:ChartNoAxesCombined, group:'INSIGHTS' },
  { label:'Earnings', icon:Wallet, group:'INSIGHTS' },
  { label:'Community', icon:UsersRound, group:'INSIGHTS' },
  { label:'Notifications', icon:Bell, group:'OTHER' },
  { label:'Settings', icon:Settings, group:'OTHER' },
];
const gradients = ['g-purple','g-cyan','g-orange','g-pink','g-blue','g-green'];
const initials = (s='CV') => s.split(' ').slice(0,2).map(x=>x[0]).join('').toUpperCase();
const money = n => n == null ? 'Budget flexible' : '₹' + Number(n).toLocaleString('en-IN');

async function api(path, { token, method='GET', body }={}) {
  const res = await fetch(`${API}${path}`, { method, headers: { ...(body ? {'Content-Type':'application/json'} : {}), ...(token ? {Authorization:`Bearer ${token}`} : {}) }, body: body ? JSON.stringify(body) : undefined });
  const data = await res.json().catch(()=>({detail:'Unexpected server response'}));
  if (!res.ok) throw new Error(data.detail || 'Something went wrong');
  return data;
}
function App(){
  const [token,setToken] = useState(localStorage.getItem('cv_token') || '');
  const [user,setUser] = useState(()=>{try{return JSON.parse(localStorage.getItem('cv_user')||'null')}catch{return null}});
  const [page,setPage] = useState('Dashboard'); const [mobileOpen,setMobileOpen] = useState(false);
  const [creators,setCreators] = useState([]); const [creatorTotal,setCreatorTotal] = useState(0); const [briefs,setBriefs] = useState([]); const [projects,setProjects] = useState([]); const [collabs,setCollabs] = useState([]); const [analytics,setAnalytics] = useState(null);
  const [loading,setLoading] = useState(false); const [toast,setToast] = useState(null); const [globalSearch,setGlobalSearch] = useState('');
  const [search,setSearch] = useState(''); const [skill,setSkill] = useState(''); const [tool,setTool] = useState(''); const [contentType,setContentType] = useState(''); const [specialization,setSpecialization] = useState(''); const [verified,setVerified] = useState(''); const [sort,setSort] = useState('relevant');
  const [profile,setProfile] = useState(null); const [showLogin,setShowLogin] = useState(false); const [loginRole,setLoginRole] = useState('creator'); const [fullName,setFullName] = useState(''); const [email,setEmail] = useState(demoLogins.creator); const [password,setPassword] = useState('DemoPass123!'); const [loginMode,setLoginMode] = useState('login'); const [awaitingVerification,setAwaitingVerification] = useState(false); const [otp,setOtp] = useState(''); const [authBusy,setAuthBusy] = useState(false);
  const [showProjectForm,setShowProjectForm] = useState(false); const [editingProject,setEditingProject] = useState(null); const [showBriefForm,setShowBriefForm] = useState(false); const [briefEditing,setBriefEditing] = useState(null); const [reviewBrief,setReviewBrief] = useState(null); const [applications,setApplications] = useState([]); const [aiIdea,setAiIdea] = useState(''); const [aiLoading,setAiLoading] = useState(false); const [aiResult,setAiResult] = useState(null); const [selectedCreator,setSelectedCreator] = useState(null); const [selectedBrief,setSelectedBrief] = useState(null); const [applicationBrief,setApplicationBrief] = useState(null); const [applicationText,setApplicationText] = useState('I would love to collaborate on this campaign. My workflow focuses on strong visual storytelling, prompt iteration, and polished delivery.');
  const [projectForm,setProjectForm] = useState({title:'',description:'',content_type:'AI Video',visual_style:'Cinematic',preview_url:'',tools:'Runway, Midjourney',skills:'Prompt Design, Visual Storytelling',workflow:'Concept → reference board → prompt iteration → generation → post-production → export',prompt_notes:'',prompt_private:true,aspect_ratio:'9:16',output_format:'MP4',commercial_use:false,license_type:'Review required',visibility:'Public'});
  const [briefForm,setBriefForm] = useState({title:'',description:'',brand_name:'',industry:'Technology',objective:'Brand awareness',target_audience:'Digital-first audience, ages 18–35',content_type:'AI Video',visual_style:'Cinematic',platform:'Instagram Reels',aspect_ratio:'9:16',output_format:'MP4',budget_min:'',budget_max:'',deadline:'',deliverables:1,required_skills:'Prompt Design, Visual Storytelling',required_tools:'Runway, Midjourney',commercial_use:true,license_type:'Non-exclusive campaign license',usage_rights:'Digital campaign use; final scope to be agreed in writing',ai_disclosure:'Disclose AI-generated content',revision_rounds:2,status:'Draft'});
  const [profileForm,setProfileForm] = useState(null);
  const notify = (message,type='success') => { setToast({message,type}); setTimeout(()=>setToast(null),3600); };
  const signIn = async (role=loginRole) => {
    setAuthBusy(true);
    try {
      if (loginMode === 'register') {
        const res = await api('/api/auth/register', {method:'POST', body:{name:fullName.trim(), email:email.trim().toLowerCase(), password, role}});
        setAwaitingVerification(true); setOtp('');
        notify(res.message || 'Verification code sent. Check your email.');
        return;
      }
      const res = await api('/api/auth/login', {method:'POST',body:{email:email.trim().toLowerCase(),password}});
      setToken(res.access_token); setUser(res.user); localStorage.setItem('cv_token',res.access_token); localStorage.setItem('cv_user',JSON.stringify(res.user)); setShowLogin(false); setAwaitingVerification(false); notify(`Welcome to CREOVANTA, ${res.user.name.split(' ')[0]}!`);
    } catch(e) { notify(e.message,'error'); }
    finally { setAuthBusy(false); }
  };
  const verifyEmailOtp = async () => {
    if (!/^\d{6}$/.test(otp.trim())) { notify('Enter the 6-digit code from your email','error'); return; }
    setAuthBusy(true);
    try {
      const res = await api('/api/auth/verify-otp',{method:'POST',body:{email:email.trim().toLowerCase(),otp:otp.trim()}});
      setAwaitingVerification(false); setOtp('');
      if (res.access_token && res.user) {
        setToken(res.access_token); setUser(res.user); localStorage.setItem('cv_token',res.access_token); localStorage.setItem('cv_user',JSON.stringify(res.user)); setShowLogin(false); notify(`Email verified. Welcome to CREOVANTA, ${res.user.name.split(' ')[0]}!`);
      } else { setLoginMode('login'); notify('Email verified! Please sign in.'); }
    } catch(e) { notify(e.message,'error'); }
    finally { setAuthBusy(false); }
  };
  const resendEmailOtp = async () => {
    setAuthBusy(true);
    try { const res = await api('/api/auth/resend-otp',{method:'POST',body:{email:email.trim().toLowerCase()}}); notify(res.message || 'A new code has been sent.'); }
    catch(e) { notify(e.message,'error'); }
    finally { setAuthBusy(false); }
  };
  const logout = () => { setToken('');setUser(null);localStorage.removeItem('cv_token');localStorage.removeItem('cv_user');setProfile(null);setPage('Dashboard');notify('Signed out successfully'); };
  const loginAs = role => {setLoginRole(role);setEmail(demoLogins[role]);setPassword('DemoPass123!');setLoginMode('login');setShowLogin(true)};
  const loadAll = async () => { setLoading(true); try { const [cr,br,an] = await Promise.all([api('/api/creators?page_size=50'),api('/api/briefs',{token}),api('/api/analytics/dashboard')]); setCreators(cr.items||[]);setCreatorTotal(cr.total||0);setBriefs(br);setAnalytics(an); if(token){try{const [me,co]=await Promise.all([api('/api/auth/me',{token}),api('/api/collaborations',{token})]);setUser(me);setCollabs(co);localStorage.setItem('cv_user',JSON.stringify(me)); if(me.role==='creator'){const p=await api('/api/creators/me/profile',{token});setProfile(p);setProfileForm(toProfileForm(p));setProjects(p.projects||[])} }catch(e){ if(e.message.includes('session')||e.message.includes('Sign in'))logout(); }} } catch(e){notify(`Could not connect to API: ${e.message}. Start the backend first.`,'error')} finally{setLoading(false)} };
  useEffect(()=>{loadAll()},[token]);
  const searchCreators = async () => { setLoading(true); try {const params=new URLSearchParams();if(search)params.set('search',search);if(skill)params.set('skills',skill);if(tool)params.set('tools',tool);if(contentType)params.set('content_type',contentType);if(specialization)params.set('specialization',specialization);if(verified)params.set('verified',verified);params.set('sort',sort);params.set('page_size','50');const d=await api('/api/creators?'+params.toString());setCreators(d.items);setCreatorTotal(d.total)}catch(e){notify(e.message,'error')}finally{setLoading(false)} };
  useEffect(()=>{if(page==='Discover Creators')searchCreators()},[page,search,skill,tool,contentType,specialization,verified,sort]);
  const toProfileForm = p => ({name:p.name||'',username:p.username||'',biography:p.biography||'',specialization:p.specialization||'AI Video',experience_level:p.experience_level||'Intermediate',availability:p.availability||'Available',rate_min:p.rate_min??'',rate_max:p.rate_max??'',skills:(p.skills||[]).join(', '),tools:(p.tools||[]).join(', '),content_types:(p.content_types||[]).join(', '),formats:(p.formats||[]).join(', '),aspect_ratios:(p.aspect_ratios||[]).join(', '),languages:(p.languages||[]).join(', '),workflow:p.workflow||''});
  const saveProfile = async e => {e.preventDefault();try{const body={...profileForm,rate_min:profileForm.rate_min===''?null:Number(profileForm.rate_min),rate_max:profileForm.rate_max===''?null:Number(profileForm.rate_max)};for(const k of ['skills','tools','content_types','formats','aspect_ratios','languages'])body[k]=body[k].split(',').map(x=>x.trim()).filter(Boolean);const p=await api('/api/creators/me/profile',{token,method:'PUT',body});setProfile(p);setProfileForm(toProfileForm(p));notify('Creator profile updated')}catch(e){notify(e.message,'error')}};
  const saveProject = async e => {e.preventDefault();if(!token){notify('Sign in as a creator to manage your portfolio','error');return}try{const body={...projectForm,tools:projectForm.tools.split(',').map(x=>x.trim()).filter(Boolean),skills:projectForm.skills.split(',').map(x=>x.trim()).filter(Boolean)};const p=editingProject?await api(`/api/portfolio/${editingProject.id}`,{token,method:'PUT',body}):await api('/api/portfolio',{token,method:'POST',body});setProjects(old=>editingProject?old.map(x=>x.id===p.id?p:x):[p,...old]);setShowProjectForm(false);setEditingProject(null);notify(editingProject?'Portfolio project updated':'Portfolio project added');loadAll()}catch(e){notify(e.message,'error')}};
  const openNewProject = p => {setEditingProject(p||null);setProjectForm(p?{...p,tools:(p.tools||[]).join(', '),skills:(p.skills||[]).join(', ')}:{title:'',description:'',content_type:'AI Video',visual_style:'Cinematic',preview_url:'',tools:'Runway, Midjourney',skills:'Prompt Design, Visual Storytelling',workflow:'Concept → reference board → prompt iteration → generation → post-production → export',prompt_notes:'',prompt_private:true,aspect_ratio:'9:16',output_format:'MP4',commercial_use:false,license_type:'Review required',visibility:'Public'});setShowProjectForm(true)};
  const deleteProject = async id => {if(!confirm('Delete this portfolio project?'))return;try{await api(`/api/portfolio/${id}`,{token,method:'DELETE'});setProjects(p=>p.filter(x=>x.id!==id));notify('Project deleted')}catch(e){notify(e.message,'error')}};
  const saveBrief = async (e,publish=false) => {e?.preventDefault();if(!token){notify('Sign in as a brand to create a brief','error');return}try{const body={...briefForm,budget_min:briefForm.budget_min===''?null:Number(briefForm.budget_min),budget_max:briefForm.budget_max===''?null:Number(briefForm.budget_max),deadline:briefForm.deadline||null,deliverables:Number(briefForm.deliverables),revision_rounds:Number(briefForm.revision_rounds),required_skills:briefForm.required_skills.split(',').map(x=>x.trim()).filter(Boolean),required_tools:briefForm.required_tools.split(',').map(x=>x.trim()).filter(Boolean),status:publish?'Published':briefForm.status};if(briefEditing){await api(`/api/briefs/${briefEditing.id}`,{token,method:'PUT',body})}else{await api('/api/briefs',{token,method:'POST',body})}setShowBriefForm(false);setBriefEditing(null);notify(publish?'Brief published successfully':'Brief saved as draft');await loadAll();setPage('Creative Briefs')}catch(e){notify(e.message,'error')}};
  const runAI = async () => {setAiLoading(true);try{const r=await api('/api/ai/brief-builder',{token,method:'POST',body:{idea:aiIdea}});setAiResult(r);setBriefForm(f=>({...f,...r.brief,budget_min:'',budget_max:'',deadline:'',required_skills:r.brief.required_skills.join(', '),required_tools:r.brief.required_tools.join(', ')}));notify('AI suggestions generated — review every field')}catch(e){notify(e.message,'error')}finally{setAiLoading(false)}};
  const applyToBrief = async e => {e.preventDefault();try{await api(`/api/briefs/${applicationBrief.id}/applications`,{token,method:'POST',body:{proposal:applicationText,proposed_budget:null}});notify('Application submitted');setApplicationBrief(null)}catch(e){notify(e.message,'error')}};
  const editBrief = b => {setBriefEditing(b);setBriefForm({...b,budget_min:b.budget_min??'',budget_max:b.budget_max??'',deadline:b.deadline||'',required_skills:(b.required_skills||[]).join(', '),required_tools:(b.required_tools||[]).join(', ')});setShowBriefForm(true)};
  const startNewBrief = () => {setBriefEditing(null);setBriefForm({title:'',description:'',brand_name:user?.name||'',industry:'Technology',objective:'Brand awareness',target_audience:'Digital-first audience, ages 18–35',content_type:'AI Video',visual_style:'Cinematic',platform:'Instagram Reels',aspect_ratio:'9:16',output_format:'MP4',budget_min:'',budget_max:'',deadline:'',deliverables:1,required_skills:'Prompt Design, Visual Storytelling',required_tools:'Runway, Midjourney',commercial_use:true,license_type:'Non-exclusive campaign license',usage_rights:'Digital campaign use; final scope to be agreed in writing',ai_disclosure:'Disclose AI-generated content',revision_rounds:2,status:'Draft'});setShowBriefForm(true)};
  const updateCollab = async (id,status) => {try{await api(`/api/collaborations/${id}`,{token,method:'PATCH',body:{status}});setCollabs(await api('/api/collaborations',{token}));notify(`Collaboration moved to ${status}`)}catch(e){notify(e.message,'error')}};
  const openApplications = async brief => {try{const rows=await api(`/api/briefs/${brief.id}/applications`,{token});setApplications(rows);setReviewBrief(brief)}catch(e){notify(e.message,'error')}};
  const updateApplication = async (id,status) => {try{await api(`/api/applications/${id}`,{token,method:'PATCH',body:{status}});setApplications(rows=>rows.map(a=>a.id===id?{...a,status}:a));notify(`Application ${status.toLowerCase()}`);if(status==='Accepted'){setCollabs(await api('/api/collaborations',{token}));}}catch(e){notify(e.message,'error')}};
  const visibleBriefs = useMemo(()=>briefs.filter(b=>b.status==='Published'||(user?.role==='brand'&&b.brand_user_id===user.id)||user?.role==='admin'),[briefs,user]);
  const isCreator = user?.role==='creator'; const isBrand = user?.role==='brand';
  const activeNav = (label) => {setPage(label);setMobileOpen(false);setSelectedCreator(null);setSelectedBrief(null)};
  const avatar = (name, cls='avatar') => <div className={cls}>{initials(name||'CV')}</div>;
  const cover = (i=0,content='AI CREATIVE') => <div className={`art-cover ${gradients[i%gradients.length]}`}><div className="art-orb orb-one"/><div className="art-orb orb-two"/><span>{content}</span><small>CREOVANTA / CONCEPT {String(i+1).padStart(2,'0')}</small></div>;
  const statCard = (icon,title,value,delta,color) => <div className="stat-card" key={title}><div className={`stat-icon ${color}`}><icon.type size={19}/></div><div className="stat-title">{title}</div><div className="stat-value">{value}</div><div className="stat-foot"><span className="up"><ArrowUpRight size={14}/>{delta}</span><span>vs last month</span></div></div>;

  return <div className="app-shell">
    <aside className={`sidebar ${mobileOpen?'open':''}`}><div className="brand-lockup"><div className="brand-mark"><Sparkles size={21}/></div><div><div className="brand-name">CREOVANTA<span>®</span></div><div className="brand-sub">CREATOR INTELLIGENCE</div></div><button className="icon-btn mobile-close" onClick={()=>setMobileOpen(false)}><X size={18}/></button></div>
      <div className="workspace-switch"><div className="workspace-avatar">C</div><div className="workspace-copy"><b>Creative Studio</b><span>{user?.role?`${user.role[0].toUpperCase()+user.role.slice(1)} workspace`:'Demo workspace'}</span></div><ChevronDown size={15}/></div>
      {['WORKSPACE','CREATE','INSIGHTS','OTHER'].map(group=><div className="nav-group" key={group}><div className="nav-caption">{group}</div>{navItems.filter(n=>n.group===group).map(n=><button key={n.label} onClick={()=>activeNav(n.label)} className={`nav-item ${page===n.label?'active':''}`}><n.icon size={17}/><span>{n.label}</span>{n.label==='Notifications'&&<span className="nav-dot"/>}{n.label==='Brand Deals'&&<span className="nav-count">4</span>}</button>)}</div>)}
      <div className="sidebar-bottom"><div className="upgrade-card"><div className="upgrade-icon"><Zap size={16}/></div><b>Make ideas happen.</b><p>Find your next creative collaboration.</p><button onClick={()=>activeNav('Discover Creators')}>Explore creators <ArrowUpRight size={13}/></button><div className="upgrade-glow"/></div><div className="sidebar-user">{avatar(user?.name||'Demo User','avatar user-avatar')}<div className="user-copy"><b>{user?.name||'Guest explorer'}</b><span>{user?.email||'Sign in to unlock actions'}</span></div>{user?<button className="icon-btn" title="Sign out" onClick={logout}><LogOut size={16}/></button>:<button className="icon-btn" title="Sign in" onClick={()=>setShowLogin(true)}><ArrowUpRight size={16}/></button>}</div></div>
    </aside>
    {mobileOpen&&<div className="scrim" onClick={()=>setMobileOpen(false)}/>}
    <main className="main-area"><header className="topbar"><div className="top-left"><button className="icon-btn mobile-menu" onClick={()=>setMobileOpen(true)}><Menu size={20}/></button><div className="breadcrumb">Studio <span>/</span> <b>{page}</b></div></div><div className="top-actions"><label className="global-search"><Search size={16}/><input placeholder="Search creators, projects..." value={globalSearch} onChange={e=>setGlobalSearch(e.target.value)} onKeyDown={e=>e.key==='Enter'&&(setSearch(globalSearch),setPage('Discover Creators'))}/><kbd>⌘ K</kbd></label><button className="top-icon" title="Notifications" onClick={()=>activeNav('Notifications')}><Bell size={18}/><i/></button><button className="help-btn" onClick={()=>notify('Tip: start with creator discovery, then create a brief and apply to collaborate.')}>Help <span>?</span></button>{user?<button className="top-profile" onClick={()=>setShowLogin(true)}>{avatar(user.name,'avatar top-avatar')}<span>{user.name.split(' ')[0]}</span><ChevronDown size={14}/></button>:<button className="btn btn-primary btn-sm" onClick={()=>setShowLogin(true)}>Sign in</button>}</div></header>
      <div className="page-content">
        {page==='Dashboard'&&<>
          <div className="welcome-row"><div><div className="eyebrow"><span className="live-dot"/> CREATIVE INTELLIGENCE PLATFORM</div><h1>Make room for <span className="gradient-text">what's next.</span></h1><p className="page-subtitle">Your creative world, connected. Discover talent, shape ideas, and bring bold work to life.</p></div><div className="welcome-actions"><button className="btn btn-ghost" onClick={()=>activeNav('Discover Creators')}><Compass size={16}/> Discover talent</button><button className="btn btn-primary" onClick={()=>isBrand?startNewBrief():isCreator?openNewProject():setShowLogin(true)}><Plus size={17}/>{isBrand?'Create brief':isCreator?'Add portfolio':'Get started'}</button></div></div>
          <div className="hero-banner"><div className="hero-copy"><div className="hero-label"><Sparkles size={14}/> THE CREATOR ECONOMY, REIMAGINED</div><h2>Big ideas deserve<br/><span>brilliant collaborators.</span></h2><p>Meet the makers behind the next wave of AI-powered creativity.</p><button className="hero-link" onClick={()=>activeNav('Discover Creators')}>Explore the creator network <ArrowUpRight size={16}/></button></div><div className="hero-art"><div className="hero-ring ring-a"/><div className="hero-ring ring-b"/><div className="hero-glass"><Sparkles size={40}/></div><div className="floating-tag tag-a"><span className="tag-dot violet"/> AI FILMMAKING</div><div className="floating-tag tag-b"><span className="tag-dot cyan"/> GEN ART</div><div className="floating-tag tag-c"><span className="tag-dot coral"/> MOTION DESIGN</div></div><div className="hero-index">01 — 04</div></div>
          <div className="section-head"><div><div className="eyebrow">YOUR STUDIO AT A GLANCE</div><h2>Creative pulse <span className="muted">/ overview</span></h2></div><span className="demo-note"><span/> Database totals</span></div>
          <div className="stats-grid">{statCard({type:Sparkles},'Total creators',analytics?.total_creators??0,'18.4%','violet')}{statCard({type:PanelsTopLeft},'Portfolio projects',analytics?.portfolio_projects??0,'12.8%','cyan')}{statCard({type:FileText},'Active briefs',analytics?.active_briefs??0,'8.2%','orange')}{statCard({type:Handshake},'Collaborations',analytics?.active_collaborations??0,'Live','pink')}</div>
          <div className="dashboard-grid"><section className="panel trend-panel"><div className="panel-head"><div><h3>Creative activity</h3><p>Projects and briefs across the studio</p></div><button className="select-like" onClick={()=>notify('Live monthly trend data is not available yet')}>Last 6 months <ChevronDown size={14}/></button></div><div className="chart-legend"><span><i className="legend-violet"/> Portfolio projects</span><span><i className="legend-cyan"/> Creative briefs</span></div><div className="bar-chart">{(analytics?.monthly_activity||[]).map((d,i)=><div className="bar-group" key={d.month}><div className="bars"><div className="bar bar-violet" style={{height:`${d.projects*2.2}px`}} title={`${d.projects} projects`}/><div className="bar bar-cyan" style={{height:`${d.briefs*2.2}px`}} title={`${d.briefs} briefs`}/></div><span>{d.month}</span></div>)}</div><div className="chart-footer"><span><Activity size={14}/> Platform activity from available database records</span><button onClick={()=>activeNav('Analytics')}>View analytics <ArrowUpRight size={14}/></button></div></section>
            <section className="panel format-panel"><div className="panel-head"><div><h3>Content mix</h3><p>Popular creative formats</p></div><button className="more-btn" onClick={()=>activeNav('Analytics')}>•••</button></div><div className="donut-wrap"><div className="donut"><div><strong>100%</strong><span>Content mix</span></div></div><div className="donut-center-label"><strong>4</strong><span>formats</span></div></div><div className="format-legend">{(analytics?.popular_formats||[]).map((d,i)=><div key={d.name}><span className={`legend-dot dot-${i}`}/><span>{d.name}</span><b>{d.value}%</b></div>)}</div></section></div>
          <div className="section-head lower-head"><div><div className="eyebrow">HANDPICKED FOR YOU</div><h2>Creators to watch <span className="muted">/ featured</span></h2></div><button className="text-link" onClick={()=>activeNav('Discover Creators')}>View all creators <ArrowUpRight size={15}/></button></div>
          <div className="creator-grid">{creators.slice(0,4).map((c,i)=><CreatorCard key={c.id} c={c} i={i} cover={cover} avatar={avatar} onView={()=>setSelectedCreator(c)} onInvite={()=>{if(!user){setShowLogin(true);return}activeNav('Creative Briefs')}}/>)}</div>
          <div className="section-head lower-head"><div><div className="eyebrow">FRESH OPPORTUNITIES</div><h2>Briefs in motion <span className="muted">/ open calls</span></h2></div><button className="text-link" onClick={()=>activeNav('Creative Briefs')}>Browse briefs <ArrowUpRight size={15}/></button></div><div className="brief-list">{visibleBriefs.slice(0,3).map((b,i)=><BriefRow key={b.id} b={b} i={i} onView={()=>setSelectedBrief(b)} onApply={()=>user?.role==='creator'?setApplicationBrief(b):!user?setShowLogin(true):notify('Switch to a creator account to apply','error')}/>)}</div>
        </>}
        {page==='Discover Creators'&&<><div className="page-title-row"><div><div className="eyebrow">THE TALENT NETWORK</div><h1>Discover <span className="gradient-text">creators.</span></h1><p className="page-subtitle">Find the right creative mind for your next big idea.</p></div><button className="btn btn-ghost" onClick={()=>{setSearch('');setSkill('');setTool('');setContentType('');setSpecialization('');setVerified('');setSort('relevant')}}><X size={15}/> Clear filters</button></div><div className="discovery-layout"><aside className="filter-panel"><div className="filter-title"><SlidersHorizontal size={17}/><b>Refine search</b><span>{creatorTotal}</span></div><label className="field-label">Search keywords<input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Name, skill, tool..."/></label><label className="field-label">Specialization<select value={specialization} onChange={e=>setSpecialization(e.target.value)}><option value="">All specializations</option>{['AI Filmmaker','Generative Artist','AI Animator','Product Ads','Social Video','3D Artist','AI Video'].map(x=><option>{x}</option>)}</select></label><label className="field-label">AI tool<select value={tool} onChange={e=>setTool(e.target.value)}><option value="">Any tool</option>{['Runway','Midjourney','Pika','Blender','Stable Diffusion','ComfyUI','Sora','DALL·E','Photoshop AI'].map(x=><option>{x}</option>)}</select></label><label className="field-label">Content type<select value={contentType} onChange={e=>setContentType(e.target.value)}><option value="">All content</option>{['AI Video','AI Image','Animation','Advertisement','Social Video','Experimental Art'].map(x=><option>{x}</option>)}</select></label><label className="field-label">Skill<select value={skill} onChange={e=>setSkill(e.target.value)}><option value="">Any skill</option>{['Prompt Design','Cinematic Lighting','Storyboarding','Generative Art','Color Grading','Motion Design','3D Animation','ComfyUI','Image Editing','Ad Creative','Video Editing','Concept Art'].map(x=><option>{x}</option>)}</select></label><label className="field-label">Evidence status<select value={verified} onChange={e=>setVerified(e.target.value)}><option value="">Any status</option><option>Self-reported</option><option>Pending review</option><option>Workflow reviewed</option><option>Past work reviewed</option></select></label><label className="field-label">Sort by<select value={sort} onChange={e=>setSort(e.target.value)}><option value="relevant">Most relevant</option><option value="recent">Recently joined</option><option value="projects">Most portfolio projects</option><option value="verified">Evidence reviewed</option><option value="rate_low">Lowest disclosed rate</option><option value="rate_high">Highest disclosed rate</option></select></label><div className="filter-tip"><Sparkles size={16}/><span><b>Discovery tip</b>Combine a tool and content type to narrow the shortlist.</span></div></aside><div className="results-area"><div className="results-toolbar"><span><b>{creatorTotal}</b> creators found</span><span className="demo-note"><span/> Database profiles</span></div>{loading?<div className="empty-state">Loading creators...</div>:creators.length===0?<div className="empty-state"><Search size={30}/><h3>No creators match those filters</h3><p>Try a broader keyword or clear one of your filters.</p><button className="btn btn-primary" onClick={()=>{setSearch('');setSkill('');setTool('');setContentType('');setSpecialization('');setVerified('')}}>Clear filters</button></div>:<div className="creator-grid discover-grid">{creators.map((c,i)=><CreatorCard key={c.id} c={c} i={i} cover={cover} avatar={avatar} onView={()=>setSelectedCreator(c)} onInvite={()=>{if(!user){setShowLogin(true);return}activeNav('Creative Briefs')}}/>)}</div>}</div></div></>}
        {page==='My Profile'&&<><div className="page-title-row"><div><div className="eyebrow">YOUR CREATIVE IDENTITY</div><h1>My <span className="gradient-text">profile.</span></h1><p className="page-subtitle">Tell brands what you create and how you work.</p></div></div>{!user?<SignInPanel onLogin={()=>setShowLogin(true)}/>:!isCreator?<div className="empty-state"><UserRound size={28}/><h3>Creator profile is for creator accounts</h3><p>Sign in with a creator account to edit a public creator profile.</p><button className="btn btn-primary" onClick={()=>loginAs('creator')}>Switch to creator demo</button></div>:profileForm&&<form className="panel edit-form" onSubmit={saveProfile}><div className="form-section-head"><div><h3>Public profile</h3><p>Fields with commas accept multiple values.</p></div><span className="status-pill status-demo">{profile?.verification_status||'Self-reported'}</span></div><div className="form-grid"><Field label="Full name"><input value={profileForm.name} onChange={e=>setProfileForm({...profileForm,name:e.target.value})} required/></Field><Field label="Username"><input value={profileForm.username} onChange={e=>setProfileForm({...profileForm,username:e.target.value})} required/></Field><Field label="Specialization"><select value={profileForm.specialization} onChange={e=>setProfileForm({...profileForm,specialization:e.target.value})}>{['AI Filmmaker','Generative Artist','AI Animator','Product Ads','Social Video','3D Artist','AI Video'].map(x=><option>{x}</option>)}</select></Field><Field label="Experience"><select value={profileForm.experience_level} onChange={e=>setProfileForm({...profileForm,experience_level:e.target.value})}>{['Beginner','Intermediate','Advanced','Expert'].map(x=><option>{x}</option>)}</select></Field><Field label="Availability"><select value={profileForm.availability} onChange={e=>setProfileForm({...profileForm,availability:e.target.value})}>{['Available','Limited availability','Booked until next month'].map(x=><option>{x}</option>)}</select></Field><Field label="Languages"><input value={profileForm.languages} onChange={e=>setProfileForm({...profileForm,languages:e.target.value})}/></Field><Field label="Starting rate (₹)"><input type="number" min="0" value={profileForm.rate_min} onChange={e=>setProfileForm({...profileForm,rate_min:e.target.value})}/></Field><Field label="Maximum rate (₹)"><input type="number" min="0" value={profileForm.rate_max} onChange={e=>setProfileForm({...profileForm,rate_max:e.target.value})}/></Field><Field label="Skills (comma-separated)" wide><input value={profileForm.skills} onChange={e=>setProfileForm({...profileForm,skills:e.target.value})}/></Field><Field label="AI tools (comma-separated)" wide><input value={profileForm.tools} onChange={e=>setProfileForm({...profileForm,tools:e.target.value})}/></Field><Field label="Content types" wide><input value={profileForm.content_types} onChange={e=>setProfileForm({...profileForm,content_types:e.target.value})}/></Field><Field label="Output formats" ><input value={profileForm.formats} onChange={e=>setProfileForm({...profileForm,formats:e.target.value})}/></Field><Field label="Aspect ratios"><input value={profileForm.aspect_ratios} onChange={e=>setProfileForm({...profileForm,aspect_ratios:e.target.value})}/></Field><Field label="Bio" wide><textarea rows="4" value={profileForm.biography} onChange={e=>setProfileForm({...profileForm,biography:e.target.value})}/></Field><Field label="Workflow" wide><textarea rows="3" value={profileForm.workflow} onChange={e=>setProfileForm({...profileForm,workflow:e.target.value})}/></Field></div><div className="form-actions"><button className="btn btn-primary"><CheckCircle2 size={16}/> Save profile</button></div></form>}</>}
        {page==='AI Portfolio'&&<><div className="page-title-row"><div><div className="eyebrow">PROVE YOUR PROCESS</div><h1>AI <span className="gradient-text">portfolio.</span></h1><p className="page-subtitle">Show the craft, the tools, and the workflow behind every result.</p></div><button className="btn btn-primary" onClick={()=>user?.role==='creator'?openNewProject():!user?setShowLogin(true):notify('Portfolio management is available to creators','error')}><Plus size={16}/> Add project</button></div>{!user?<SignInPanel onLogin={()=>setShowLogin(true)}/>:<><div className="portfolio-summary"><div><span className="summary-icon"><PanelsTopLeft size={20}/></span><div><b>{projects.length} projects</b><span>Your portfolio library</span></div></div><div><span className="summary-icon cyan-bg"><BadgeCheck size={20}/></span><div><b>{profile?.verification_status||'Self-reported'}</b><span>Evidence status</span></div></div><div><span className="summary-icon orange-bg"><Eye size={20}/></span><div><b>Public visibility</b><span>Review each project's setting</span></div></div></div><div className="portfolio-grid">{(isCreator?projects:creators.flatMap(c=>c.projects||[])).map((p,i)=><div className="portfolio-card" key={p.id}>{p.preview_url? <img className="portfolio-preview" src={p.preview_url} alt={p.title} onError={e=>e.currentTarget.style.display='none'}/>:cover(i,p.content_type.toUpperCase())}<div className="portfolio-card-body"><div className="card-overline">{p.content_type} <span>·</span> {p.aspect_ratio}</div><h3>{p.title}</h3><p>{p.description}</p><div className="tag-row">{(p.tools||[]).slice(0,2).map(t=><span className="tag" key={t}>{t}</span>)}</div><div className="portfolio-card-foot"><span className={`status-pill ${p.commercial_use?'status-green':'status-demo'}`}>{p.commercial_use?'Commercial terms stated':'Rights to confirm'}</span>{isCreator&&<div className="mini-actions"><button onClick={()=>openNewProject(p)} title="Edit"><Edit3 size={15}/></button><button onClick={()=>deleteProject(p.id)} title="Delete"><Trash2 size={15}/></button></div>}</div></div></div>)}</div>{(isCreator?projects:creators.flatMap(c=>c.projects||[])).length===0&&<div className="empty-state"><PanelsTopLeft size={28}/><h3>Your next great project belongs here</h3><p>Add your first project to make your skills discoverable.</p><button className="btn btn-primary" onClick={()=>openNewProject()}>Add portfolio project</button></div>}</>}</>}
        {page==='Creative Briefs'&&<><div className="page-title-row"><div><div className="eyebrow">CAMPAIGNS WITH CLARITY</div><h1>Creative <span className="gradient-text">briefs.</span></h1><p className="page-subtitle">A great brief turns a big idea into a clear collaboration.</p></div>{isBrand&&<button className="btn btn-primary" onClick={startNewBrief}><Plus size={16}/> Create brief</button>}{!user&&<button className="btn btn-primary" onClick={()=>setShowLogin(true)}>Sign in to create</button>}</div><div className="brief-intro-strip"><div className="ai-icon"><WandSparkles size={22}/></div><div><b>Got an idea, not a brief?</b><p>Let CREOVANTA's AI assistant structure your campaign. You can edit everything before publishing.</p></div><button className="btn btn-ghost" onClick={()=>document.getElementById('ai-builder')?.scrollIntoView({behavior:'smooth'})}>Try AI builder <ArrowUpRight size={15}/></button></div><div className="ai-builder panel" id="ai-builder"><div className="ai-builder-head"><div className="ai-badge"><Sparkles size={18}/></div><div><h3>AI-assisted brief builder</h3><p>Template-powered suggestions · No external API key required</p></div><span className="status-pill status-demo">Fallback engine</span></div><div className="ai-input-row"><textarea value={aiIdea} onChange={e=>setAiIdea(e.target.value)} placeholder="Describe your campaign idea in simple words… e.g. I need a futuristic 20-second product advertisement for Instagram Reels with cinematic lighting and a premium look." rows="3"/><button className="btn btn-primary ai-generate" onClick={runAI} disabled={aiLoading||aiIdea.trim().length<10}>{aiLoading?<span className="spinner"/>:<WandSparkles size={17}/>} Generate brief</button></div>{aiResult&&<div className="ai-result"><div className="ai-result-head"><CheckCircle2 size={17}/><b>Draft suggestions generated</b><span>Review before publishing</span></div><div className="ai-result-grid"><div><small>Suggested title</small><b>{aiResult.brief.title}</b></div><div><small>Format</small><b>{aiResult.brief.content_type} · {aiResult.brief.aspect_ratio}</b></div><div><small>Visual style</small><b>{aiResult.brief.visual_style}</b></div><div><small>Still needs confirmation</small><b>{aiResult.missing_details.join(' · ')}</b></div></div><button className="btn btn-primary" onClick={()=>{if(!user){setShowLogin(true);return}if(user.role!=='brand'){notify('Sign in as a brand to save a brief','error');return}setBriefEditing(null);setShowBriefForm(true)}}>Review and edit full brief <ArrowUpRight size={15}/></button></div>}</div><div className="brief-filter-row"><h3>{isBrand?'Your campaigns':'Open opportunities'} <span>{visibleBriefs.length}</span></h3><div className="inline-select"><Filter size={14}/><select onChange={e=>setBriefs(b=>[...b].sort((x,y)=>e.target.value==='budget'?(y.budget_max||0)-(x.budget_max||0):new Date(x.deadline||'2999-01-01')-new Date(y.deadline||'2999-01-01')))}><option value="recent">Recently added</option><option value="budget">Highest budget</option><option value="deadline">Deadline soon</option></select></div></div><div className="brief-list">{visibleBriefs.map((b,i)=><BriefRow key={b.id} b={b} i={i} onView={()=>setSelectedBrief(b)} onApply={()=>user?.role==='creator'?setApplicationBrief(b):!user?setShowLogin(true):notify('Only creators can apply to briefs','error')} onEdit={isBrand&&b.brand_user_id===user?.id?()=>editBrief(b):null} onReview={isBrand&&b.brand_user_id===user?.id?()=>openApplications(b):null}/>)}</div></>}
        {page==='Collaboration Hub'&&<><div className="page-title-row"><div><div className="eyebrow">FROM MATCH TO MOMENTUM</div><h1>Collaboration <span className="gradient-text">hub.</span></h1><p className="page-subtitle">Track project status and keep the next step visible.</p></div></div>{!user?<SignInPanel onLogin={()=>setShowLogin(true)}/>:collabs.length===0?<div className="empty-state"><Handshake size={30}/><h3>Your collaborations start with a connection</h3><p>Apply to a brief or accept an application to create a tracked collaboration.</p><button className="btn btn-primary" onClick={()=>activeNav('Creative Briefs')}>Explore briefs</button></div>:<div className="collab-list">{collabs.map(c=><div className="collab-card" key={c.id}><div className="collab-icon"><Handshake size={20}/></div><div className="collab-main"><div className="card-overline">COLLABORATION #{c.id}</div><h3>{c.brief_title}</h3><p>Creator: {c.creator_name}</p><div className="timeline">{['Accepted','In Progress','Submitted','Approved','Completed'].map((s,i)=><span className={['Accepted','In Progress','Submitted','Approved','Completed'].indexOf(c.status)>=i?'done':''} key={s}>{s}</span>)}</div></div><div className="collab-side"><span className={`status-pill ${c.status==='Completed'?'status-green':'status-demo'}`}>{c.status}</span><select value={c.status} onChange={e=>updateCollab(c.id,e.target.value)}><option>Accepted</option><option>In Discussion</option><option>In Progress</option><option>Submitted</option><option>Revision Requested</option><option>Approved</option><option>Completed</option><option>Cancelled</option></select></div></div>)}</div>}</>}
        {page==='Brand Deals'&&<><div className="page-title-row"><div><div className="eyebrow">OPPORTUNITIES THAT FIT</div><h1>Brand <span className="gradient-text">deals.</span></h1><p className="page-subtitle">Campaigns with disclosed budgets and clear creative requirements.</p></div></div><div className="brief-list">{visibleBriefs.filter(b=>b.budget_max).map((b,i)=><BriefRow key={b.id} b={b} i={i} onView={()=>setSelectedBrief(b)} onApply={()=>user?.role==='creator'?setApplicationBrief(b):!user?setShowLogin(true):notify('Only creators can apply to briefs','error')}/>)}</div></>}
        {page==='Analytics'&&<><div className="page-title-row"><div><div className="eyebrow">MEASURE WHAT MOVES</div><h1>Studio <span className="gradient-text">analytics.</span></h1><p className="page-subtitle">A snapshot of totals calculated from database records.</p></div><span className="demo-note"><span/> Database totals</span></div><div className="stats-grid">{statCard({type:Sparkles},'Creators',analytics?.total_creators??0,'+18%','violet')}{statCard({type:PanelsTopLeft},'Projects',analytics?.portfolio_projects??0,'+12%','cyan')}{statCard({type:FileText},'Published briefs',analytics?.active_briefs??0,'+8%','orange')}{statCard({type:Handshake},'Applications',analytics?.applications??0,'+6%','pink')}</div><div className="panel trend-panel analytics-chart"><div className="panel-head"><div><h3>Six-month activity</h3><p>Demo trend data, not live earnings or performance guarantees</p></div></div><div className="bar-chart big-chart">{(analytics?.monthly_activity||[]).map(d=><div className="bar-group" key={d.month}><div className="bars"><div className="bar bar-violet" style={{height:`${d.projects*5}px`}}/><div className="bar bar-cyan" style={{height:`${d.briefs*5}px`}}/></div><span>{d.month}</span></div>)}</div></div></>}
        {page==='Earnings'&&<><div className="page-title-row"><div><div className="eyebrow">TRANSPARENT BY DESIGN</div><h1>Your <span className="gradient-text">earnings.</span></h1><p className="page-subtitle">CREOVANTA does not process payments in this hackathon prototype.</p></div></div><div className="notice-panel"><div className="notice-icon"><DollarSign size={22}/></div><div><h3>No real payment processing is connected</h3><p>Rates shown on creator profiles are creator-disclosed demo ranges. Budgets and earnings are not transactions, escrow, or guaranteed income. Agree terms directly and document licensing before work starts.</p></div></div><div className="stats-grid">{statCard({type:Wallet},'Tracked payments','Not connected','Prototype','violet')}{statCard({type:FileText},'Budgeted briefs',briefs.filter(b=>b.budget_max).length,'Demo','cyan')}{statCard({type:Handshake},'Collaborations',collabs.length,'Tracked','orange')}{statCard({type:BadgeCheck},'Rights confirmation','Required','Always','pink')}</div></>}
        {page==='Community'&&<><div className="page-title-row"><div><div className="eyebrow">BETTER WORK, TOGETHER</div><h1>Creator <span className="gradient-text">community.</span></h1><p className="page-subtitle">Explore disciplines, exchange process notes, and find your creative peers.</p></div></div><div className="community-grid">{[{icon:WandSparkles,title:'Prompt craft lab',text:'Share repeatable prompt patterns, workflows, and lessons learned.',tag:'PROCESS'},{icon:Video,title:'AI filmmaking circle',text:'Discuss storyboards, shot consistency, motion, and finishing.',tag:'VIDEO'},{icon:ImageIcon,title:'Generative art room',text:'Explore styles, reference handling, and visual experimentation.',tag:'ART'}].map((x,i)=><div className="community-card" key={x.title}><div className={`community-icon ${gradients[i]}`}><x.icon size={23}/></div><div className="card-overline">{x.tag} COMMUNITY</div><h3>{x.title}</h3><p>{x.text}</p><button className="text-link" onClick={()=>notify('Community discussion is a planned extension; this prototype focuses on marketplace workflows.')}>Explore group <ArrowUpRight size={14}/></button></div>)}</div></>}
        {page==='Notifications'&&<><div className="page-title-row"><div><div className="eyebrow">YOUR STUDIO INBOX</div><h1>Notifi<span className="gradient-text">cations.</span></h1><p className="page-subtitle">Important updates and next steps for your creative work.</p></div></div><div className="notification-list">{[{icon:Sparkles,title:'Welcome to CREOVANTA',text:'Explore creator portfolios and discover new creative workflows.',time:'Just now'},{icon:FileText,title:'New briefs are available',text:`There are ${briefs.filter(b=>b.status==='Published').length} published briefs in the demo marketplace.`,time:'Today'},{icon:BadgeCheck,title:'Verification transparency',text:'Only reviewed evidence should be treated as verified. Self-reported skills are labeled separately.',time:'Platform note'}].map((n,i)=><div className="notification-item" key={n.title}><div className={`notification-icon ${gradients[i]}`}><n.icon size={18}/></div><div><b>{n.title}</b><p>{n.text}</p><span>{n.time}</span></div><i/></div>)}</div></>}
        {page==='Settings'&&<><div className="page-title-row"><div><div className="eyebrow">YOUR PREFERENCES</div><h1>Studio <span className="gradient-text">settings.</span></h1><p className="page-subtitle">Manage your demo session and workspace preferences.</p></div></div><div className="panel settings-panel"><h3>Account session</h3><p>{user?`Signed in as ${user.email} with the ${user.role} role.`:'You are browsing in guest mode.'}</p><div className="settings-actions">{user?<button className="btn btn-ghost" onClick={logout}><LogOut size={16}/> Sign out</button>:<button className="btn btn-primary" onClick={()=>setShowLogin(true)}>Sign in / register</button>}<button className="btn btn-ghost" onClick={()=>loadAll()}><Activity size={16}/> Refresh data</button></div><div className="security-note"><AlertCircle size={17}/><span>Hackathon prototype: change the default JWT secret before deployment, configure allowed frontend origins, and review security before using real customer data.</span></div></div></>}
      </div><footer className="app-footer"><div><span className="footer-mark">✳</span> CREOVANTA <span>© 2026 · Create beyond imagination.</span></div><div><span className="footer-status"><i/> API-connected experience</span><span>Built for ByteXL Hackathon</span></div></footer>
    </main>
    {toast&&<div className={`toast ${toast.type==='error'?'toast-error':''}`}><span>{toast.type==='error'?<AlertCircle size={18}/>:<CheckCircle2 size={18}/>}</span>{toast.message}<button onClick={()=>setToast(null)}><X size={15}/></button></div>}
    {showLogin&&<Modal title={awaitingVerification?'Verify your email':loginMode==='register'?'Create your account':'Welcome back'} subtitle={awaitingVerification?`Enter the 6-digit code sent to ${email}.`: 'Access your CREOVANTA creative workspace.'} onClose={()=>{setShowLogin(false);setAwaitingVerification(false);setOtp('')}}>
      {!awaitingVerification&&<div className="login-tabs"><button className={loginMode==='login'?'selected':''} onClick={()=>{setLoginMode('login');setAwaitingVerification(false)}}>Sign in</button><button className={loginMode==='register'?'selected':''} onClick={()=>{setLoginMode('register');setAwaitingVerification(false);setFullName('');setEmail('');setPassword('')}}>Create account</button></div>}
      {awaitingVerification ? <form onSubmit={e=>{e.preventDefault();verifyEmailOtp()}}><div className="field-label">Email address<input type="email" value={email} readOnly/></div><div className="field-label">6-digit verification code<input type="text" inputMode="numeric" autoComplete="one-time-code" maxLength={6} pattern="[0-9]{6}" value={otp} onChange={e=>setOtp(e.target.value.replace(/\D/g,'').slice(0,6))} placeholder="Enter OTP" required/></div><button className="btn btn-primary full-btn" disabled={authBusy||otp.length!==6}>{authBusy?'Please wait…':'Verify email'} <CheckCircle2 size={16}/></button><button type="button" className="btn btn-ghost full-btn" disabled={authBusy} onClick={resendEmailOtp}>Resend code</button><p className="modal-footnote">The code expires after 10 minutes. Check your spam folder too.</p></form> : <>
      {loginMode==='register'&&<><div className="field-label">Full name<input type="text" value={fullName} onChange={e=>setFullName(e.target.value)} placeholder="Your full name" autoComplete="name" required/></div><div className="field-label">Account type<select value={loginRole} onChange={e=>setLoginRole(e.target.value)}><option value="creator">Creator</option><option value="brand">Brand / Agency</option></select></div></>}
      <div className="field-label">Email address<input type="email" value={email} onChange={e=>setEmail(e.target.value)} placeholder="you@example.com" autoComplete="email" required/></div><div className="field-label">Password<input type="password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="At least 8 characters" autoComplete={loginMode==='register'?'new-password':'current-password'} minLength={8} required/></div><button className="btn btn-primary full-btn" disabled={authBusy||!email.trim()||!password||(loginMode==='register'&&!fullName.trim())} onClick={()=>signIn()}>{authBusy?'Please wait…':loginMode==='register'?'Create account':'Sign in'} <ArrowUpRight size={16}/></button>
      {loginMode==='login'&&<><div className="login-divider"><span>OR TRY A DEMO ROLE</span></div><div className="demo-login-grid"><button onClick={()=>loginAs('creator')}><UserRound size={16}/><span><b>Creator</b><small>Portfolio & applications</small></span></button><button onClick={()=>loginAs('brand')}><BriefcaseBusiness size={16}/><span><b>Brand</b><small>Briefs & campaigns</small></span></button><button onClick={()=>loginAs('admin')}><Settings size={16}/><span><b>Admin</b><small>Review tools</small></span></button></div><p className="modal-footnote">Demo password for all roles: <code>DemoPass123!</code></p></>}
      </>}
    </Modal>}
    {showProjectForm&&<Modal title={editingProject?'Edit portfolio project':'Add portfolio project'} subtitle="Show your work and document the workflow behind it." onClose={()=>setShowProjectForm(false)} wide><form onSubmit={saveProject}><div className="form-grid"><Field label="Project title"><input required minLength="2" value={projectForm.title} onChange={e=>setProjectForm({...projectForm,title:e.target.value})}/></Field><Field label="Content type"><select value={projectForm.content_type} onChange={e=>setProjectForm({...projectForm,content_type:e.target.value})}>{['AI Video','AI Image','Animation','Advertisement','Social Video','Experimental Art'].map(x=><option>{x}</option>)}</select></Field><Field label="Visual style"><select value={projectForm.visual_style} onChange={e=>setProjectForm({...projectForm,visual_style:e.target.value})}>{['Cinematic','Realistic','3D','Anime','Minimal','Editorial','Futuristic','Experimental'].map(x=><option>{x}</option>)}</select></Field><Field label="Preview image/video URL"><input value={projectForm.preview_url} onChange={e=>setProjectForm({...projectForm,preview_url:e.target.value})} placeholder="https://... (optional)"/></Field><Field label="AI tools (comma-separated)" wide><input value={projectForm.tools} onChange={e=>setProjectForm({...projectForm,tools:e.target.value})}/></Field><Field label="Skills demonstrated" wide><input value={projectForm.skills} onChange={e=>setProjectForm({...projectForm,skills:e.target.value})}/></Field><Field label="Description" wide><textarea rows="3" required value={projectForm.description} onChange={e=>setProjectForm({...projectForm,description:e.target.value})}/></Field><Field label="Workflow steps" wide><textarea rows="3" value={projectForm.workflow} onChange={e=>setProjectForm({...projectForm,workflow:e.target.value})}/></Field><Field label="Prompt/process notes" wide><textarea rows="2" value={projectForm.prompt_notes} onChange={e=>setProjectForm({...projectForm,prompt_notes:e.target.value})}/></Field><Field label="Aspect ratio"><select value={projectForm.aspect_ratio} onChange={e=>setProjectForm({...projectForm,aspect_ratio:e.target.value})}>{['9:16','16:9','1:1','4:5','Custom'].map(x=><option>{x}</option>)}</select></Field><Field label="Output format"><select value={projectForm.output_format} onChange={e=>setProjectForm({...projectForm,output_format:e.target.value})}>{['MP4','PNG','WEBP','JPG','GIF','MOV','PDF'].map(x=><option>{x}</option>)}</select></Field><Field label="Visibility"><select value={projectForm.visibility} onChange={e=>setProjectForm({...projectForm,visibility:e.target.value})}><option>Public</option><option>Private</option></select></Field><Field label="License"><select value={projectForm.license_type} onChange={e=>setProjectForm({...projectForm,license_type:e.target.value})}>{['Review required','Personal portfolio only','Non-exclusive commercial license','Exclusive license by agreement','Demo only — confirm commercial terms'].map(x=><option>{x}</option>)}</select></Field></div><div className="checkbox-line"><label><input type="checkbox" checked={projectForm.prompt_private} onChange={e=>setProjectForm({...projectForm,prompt_private:e.target.checked})}/> Keep prompt notes private</label><label><input type="checkbox" checked={projectForm.commercial_use} onChange={e=>setProjectForm({...projectForm,commercial_use:e.target.checked})}/> Commercial use terms stated</label></div><div className="form-actions"><button type="button" className="btn btn-ghost" onClick={()=>setShowProjectForm(false)}>Cancel</button><button className="btn btn-primary"><CheckCircle2 size={16}/> Save project</button></div></form></Modal>}
    {showBriefForm&&<Modal title={briefEditing?'Edit creative brief':'Create creative brief'} subtitle="Define the deliverables, scope, budget, and usage rights clearly." onClose={()=>setShowBriefForm(false)} wide><form onSubmit={e=>saveBrief(e,false)}><div className="form-section-head"><div><h3>Campaign details</h3><p>AI-generated suggestions remain editable until you publish.</p></div></div><div className="form-grid"><Field label="Campaign title"><input required minLength="3" value={briefForm.title} onChange={e=>setBriefForm({...briefForm,title:e.target.value})}/></Field><Field label="Brand / agency"><input value={briefForm.brand_name} onChange={e=>setBriefForm({...briefForm,brand_name:e.target.value})} required/></Field><Field label="Industry"><select value={briefForm.industry} onChange={e=>setBriefForm({...briefForm,industry:e.target.value})}>{['Technology','Beauty','Fashion','Entertainment','Finance','Travel','Gaming','Environment','Food','Education','Other'].map(x=><option>{x}</option>)}</select></Field><Field label="Objective"><select value={briefForm.objective} onChange={e=>setBriefForm({...briefForm,objective:e.target.value})}>{['Brand awareness','Product launch','Engagement','Conversions','Education','Community growth'].map(x=><option>{x}</option>)}</select></Field><Field label="Content type"><select value={briefForm.content_type} onChange={e=>setBriefForm({...briefForm,content_type:e.target.value})}>{['AI Video','Animation','AI Image','Advertisement','Social Video','Explainer','Custom'].map(x=><option>{x}</option>)}</select></Field><Field label="Visual style"><select value={briefForm.visual_style} onChange={e=>setBriefForm({...briefForm,visual_style:e.target.value})}>{['Cinematic','Realistic','3D','Anime','Minimal','Editorial','Futuristic','Experimental','Custom'].map(x=><option>{x}</option>)}</select></Field><Field label="Platform"><select value={briefForm.platform} onChange={e=>setBriefForm({...briefForm,platform:e.target.value})}>{['Instagram Reels','Instagram','YouTube','Website','Advertising campaign','Other'].map(x=><option>{x}</option>)}</select></Field><Field label="Aspect ratio"><select value={briefForm.aspect_ratio} onChange={e=>setBriefForm({...briefForm,aspect_ratio:e.target.value})}>{['9:16','16:9','1:1','4:5','Custom'].map(x=><option>{x}</option>)}</select></Field><Field label="Target audience" wide><input value={briefForm.target_audience} onChange={e=>setBriefForm({...briefForm,target_audience:e.target.value})}/></Field><Field label="Campaign description" wide><textarea rows="4" required minLength="10" value={briefForm.description} onChange={e=>setBriefForm({...briefForm,description:e.target.value})}/></Field><Field label="Minimum budget (₹)"><input type="number" min="0" value={briefForm.budget_min} onChange={e=>setBriefForm({...briefForm,budget_min:e.target.value})}/></Field><Field label="Maximum budget (₹)"><input type="number" min="0" value={briefForm.budget_max} onChange={e=>setBriefForm({...briefForm,budget_max:e.target.value})}/></Field><Field label="Deadline"><input type="date" min={new Date().toISOString().slice(0,10)} value={briefForm.deadline} onChange={e=>setBriefForm({...briefForm,deadline:e.target.value})}/></Field><Field label="Number of deliverables"><input type="number" min="1" max="100" value={briefForm.deliverables} onChange={e=>setBriefForm({...briefForm,deliverables:e.target.value})}/></Field><Field label="Required skills (comma-separated)" wide><input value={briefForm.required_skills} onChange={e=>setBriefForm({...briefForm,required_skills:e.target.value})}/></Field><Field label="Preferred AI tools (comma-separated)" wide><input value={briefForm.required_tools} onChange={e=>setBriefForm({...briefForm,required_tools:e.target.value})}/></Field><Field label="License type"><select value={briefForm.license_type} onChange={e=>setBriefForm({...briefForm,license_type:e.target.value})}>{['Non-exclusive campaign license','Exclusive license by agreement','Usage license only','To be negotiated'].map(x=><option>{x}</option>)}</select></Field><Field label="AI disclosure"><select value={briefForm.ai_disclosure} onChange={e=>setBriefForm({...briefForm,ai_disclosure:e.target.value})}>{['Disclose AI-generated content','Follow platform requirements','To be confirmed'].map(x=><option>{x}</option>)}</select></Field><Field label="Usage rights" wide><textarea rows="2" value={briefForm.usage_rights} onChange={e=>setBriefForm({...briefForm,usage_rights:e.target.value})}/></Field><Field label="Revision rounds"><input type="number" min="0" max="20" value={briefForm.revision_rounds} onChange={e=>setBriefForm({...briefForm,revision_rounds:e.target.value})}/></Field><Field label="Output format"><select value={briefForm.output_format} onChange={e=>setBriefForm({...briefForm,output_format:e.target.value})}>{['MP4','PNG','WEBP','MOV','GIF','PDF','Custom'].map(x=><option>{x}</option>)}</select></Field></div><div className="checkbox-line"><label><input type="checkbox" checked={briefForm.commercial_use} onChange={e=>setBriefForm({...briefForm,commercial_use:e.target.checked})}/> Commercial use required</label></div><div className="form-actions"><button type="button" className="btn btn-ghost" onClick={()=>setShowBriefForm(false)}>Cancel</button><button type="button" className="btn btn-ghost" onClick={e=>saveBrief(e,false)}>Save draft</button><button type="button" className="btn btn-primary" onClick={e=>saveBrief(e,true)}><Send size={15}/> Publish brief</button></div></form></Modal>}
    {applicationBrief&&<Modal title="Apply to this brief" subtitle={applicationBrief.title} onClose={()=>setApplicationBrief(null)}><form onSubmit={applyToBrief}><div className="field-label">Your proposal<textarea rows="6" minLength="10" required value={applicationText} onChange={e=>setApplicationText(e.target.value)}/></div><div className="rights-callout"><AlertCircle size={16}/><span>Confirm the deliverables, budget, AI disclosure, and licensing terms with the brand before beginning paid work.</span></div><button className="btn btn-primary full-btn"><Send size={16}/> Submit application</button></form></Modal>}
    {reviewBrief&&<Modal title="Review applications" subtitle={reviewBrief.title} onClose={()=>setReviewBrief(null)} wide><div className="application-review-list">{applications.length===0?<div className="empty-state compact-empty"><FileText size={25}/><h3>No applications yet</h3><p>When creators apply to this published brief, their proposals will appear here.</p></div>:applications.map(a=><div className="application-card" key={a.id}><div className="application-avatar">{initials(a.creator_name)}</div><div className="application-main"><b>{a.creator_name}</b><span>@{a.username} · {a.proposed_budget?money(a.proposed_budget):'Budget not proposed'}</span><p>{a.proposal}</p><span className={`status-pill ${a.status==='Accepted'?'status-green':'status-demo'}`}>{a.status}</span></div><div className="application-actions"><button className="btn btn-ghost btn-sm" onClick={()=>updateApplication(a.id,'Shortlisted')}>Shortlist</button><button className="btn btn-primary btn-sm" onClick={()=>updateApplication(a.id,'Accepted')} disabled={a.status==='Accepted'}>Accept</button><button className="btn btn-ghost btn-sm" onClick={()=>updateApplication(a.id,'Rejected')}>Reject</button></div></div>)}</div></Modal>}
    {selectedCreator&&<Modal title={selectedCreator.name} subtitle={`@${selectedCreator.username} · ${selectedCreator.specialization}`} onClose={()=>setSelectedCreator(null)} wide><div className="creator-detail-head">{avatar(selectedCreator.name,'avatar detail-avatar')}<div><div className="tag-row">{selectedCreator.skills?.slice(0,4).map(t=><span className="tag" key={t}>{t}</span>)}</div><p>{selectedCreator.biography}</p><div className="creator-meta"><span><Clock3 size={14}/>{selectedCreator.availability}</span><span><BadgeCheck size={14}/>{selectedCreator.verification_status}</span><span><DollarSign size={14}/>{money(selectedCreator.rate_min)} – {money(selectedCreator.rate_max)}</span></div></div></div><div className="detail-columns"><div><h3>AI tools</h3><div className="tag-row">{selectedCreator.tools?.map(t=><span className="tag" key={t}>{t}</span>)}</div><h3>Workflow</h3><p>{selectedCreator.workflow}</p><h3>Content types</h3><div className="tag-row">{selectedCreator.content_types?.map(t=><span className="tag" key={t}>{t}</span>)}</div></div><div><h3>Selected portfolio</h3>{selectedCreator.projects?.slice(0,3).map((p,i)=><div className="mini-project" key={p.id}>{cover(i,p.content_type)}<div><b>{p.title}</b><span>{p.content_type} · {p.aspect_ratio}</span><small>{(p.tools||[]).join(', ')}</small></div></div>)}</div></div><div className="form-actions"><button className="btn btn-ghost" onClick={()=>{setSelectedCreator(null);activeNav('Discover Creators')}}>Back to discovery</button><button className="btn btn-primary" onClick={()=>{setSelectedCreator(null);if(!user)setShowLogin(true);else if(user.role==='brand')activeNav('Creative Briefs');else notify('Sign in as a brand to invite creators','error')}}><MessageCircle size={15}/> Invite to brief</button></div></Modal>}
    {selectedBrief&&<Modal title={selectedBrief.title} subtitle={`${selectedBrief.brand_name} · ${selectedBrief.industry}`} onClose={()=>setSelectedBrief(null)} wide><div className="brief-detail-grid"><div className="brief-detail-main"><span className={`status-pill ${selectedBrief.status==='Published'?'status-green':'status-demo'}`}>{selectedBrief.status}</span><h3>Campaign overview</h3><p>{selectedBrief.description}</p><div className="detail-kpis"><div><small>Budget range</small><b>{money(selectedBrief.budget_min)} – {money(selectedBrief.budget_max)}</b></div><div><small>Deadline</small><b>{selectedBrief.deadline||'To be confirmed'}</b></div><div><small>Deliverables</small><b>{selectedBrief.deliverables}</b></div></div><h3>Creative requirements</h3><div className="detail-table"><div><span>Content type</span><b>{selectedBrief.content_type}</b></div><div><span>Visual style</span><b>{selectedBrief.visual_style}</b></div><div><span>Platform / ratio</span><b>{selectedBrief.platform} · {selectedBrief.aspect_ratio}</b></div><div><span>Output</span><b>{selectedBrief.output_format}</b></div><div><span>Required skills</span><b>{(selectedBrief.required_skills||[]).join(', ')||'Flexible'}</b></div><div><span>Preferred tools</span><b>{(selectedBrief.required_tools||[]).join(', ')||'Flexible'}</b></div></div><h3>Commercial & licensing</h3><p>{selectedBrief.commercial_use?'Commercial use requested':'Commercial use not confirmed'} · {selectedBrief.license_type}</p><p>{selectedBrief.usage_rights}</p><div className="rights-callout"><AlertCircle size={16}/><span>AI content and third-party asset rights should be confirmed in writing before commercial publication.</span></div></div></div><div className="form-actions"><button className="btn btn-ghost" onClick={()=>setSelectedBrief(null)}>Close</button>{user?.role==='creator'&&selectedBrief.status==='Published'&&<button className="btn btn-primary" onClick={()=>{setApplicationBrief(selectedBrief);setSelectedBrief(null)}}><Send size={15}/> Apply to brief</button>}</div></Modal>}
  </div>;
}
function Field({label,children,wide=false}){return <label className={`field-label ${wide?'field-wide':''}`}>{label}{children}</label>}
function Modal({title,subtitle,children,onClose,wide=false}){return <div className="modal-backdrop" onMouseDown={e=>e.target===e.currentTarget&&onClose()}><div className={`modal ${wide?'modal-wide':''}`}><div className="modal-header"><div><h2>{title}</h2><p>{subtitle}</p></div><button className="icon-btn" onClick={onClose}><X size={19}/></button></div><div className="modal-content">{children}</div></div></div>}
function SignInPanel({onLogin}){return <div className="empty-state"><UserRound size={30}/><h3>Sign in to manage your creative profile</h3><p>Use the demo creator account or register your own account to continue.</p><button className="btn btn-primary" onClick={onLogin}>Sign in / register</button></div>}
function CreatorCard({c,i,cover,avatar,onView,onInvite}){return <article className="creator-card"><div className="creator-card-art">{cover(i,c.specialization?.toUpperCase()||'AI CREATOR')}<span className="availability"><i className={c.availability==='Available'?'available':''}/>{c.availability||'Availability not set'}</span></div><div className="creator-card-body"><div className="creator-ident">{avatar(c.name,'avatar creator-avatar')}<div><h3>{c.name}</h3><span>@{c.username}</span></div><button className="more-btn" onClick={onView}><ArrowUpRight size={16}/></button></div><div className="specialization">{c.specialization} <span>·</span> {c.experience_level}</div><p className="creator-bio">{c.biography}</p><div className="tag-row">{(Array.isArray(c.skills)?c.skills:[]).slice(0,3).map((t,index)=>{const label=typeof t==='string'?t:(t?.name??t?.category??'');return label?<span className="tag" key={t?.id??`${label}-${index}`}>{label}</span>:null})}</div><div className="creator-tools"><span>AI TOOLS</span>{(Array.isArray(c.tools)?c.tools:[]).slice(0,3).map(t=>typeof t==='string'?t:(t?.name??t?.category??'')).filter(Boolean).join(' · ')}</div><div className="creator-card-footer"><div><small>INDICATIVE RATE</small><b>{c.rate_min!=null?`₹${Number(c.rate_min).toLocaleString('en-IN')}+`:'Not disclosed'}</b></div><span className={`verification ${c.verification_status==='Workflow reviewed'||c.verification_status==='Past work reviewed'?'reviewed':''}`}><BadgeCheck size={14}/>{c.verification_status||'Self-reported'}</span></div><div className="creator-card-actions"><button className="btn btn-ghost" onClick={onView}>View profile</button><button className="btn btn-primary" onClick={onInvite}>Invite <ArrowUpRight size={14}/></button></div></div></article>}
function BriefRow({b, i, onView, onApply, onEdit, onReview}){return <article className="brief-row"><div className={`brief-art ${gradients[i%gradients.length]}`}><div className="brief-art-shape"><Sparkles size={25}/></div><span>{b.content_type?.toUpperCase()}</span></div><div className="brief-row-main"><div className="brief-row-meta"><span className="brand-chip">{b.brand_name}</span><span>·</span><span>{b.industry}</span><span className={`status-pill ${b.status==='Published'?'status-green':'status-demo'}`}>{b.status}</span></div><h3 onClick={onView}>{b.title}</h3><p>{b.description}</p><div className="tag-row">{(b.required_skills||[]).slice(0,3).map(t=><span className="tag" key={t}>{t}</span>)}<span className="tag tag-muted">{b.aspect_ratio}</span></div></div><div className="brief-row-side"><div className="brief-budget">{b.budget_min!=null&&b.budget_max!=null?`₹${Number(b.budget_min).toLocaleString('en-IN')} – ₹${Number(b.budget_max).toLocaleString('en-IN')}`:'Budget not specified'}</div><span><CalendarDays size={13}/>{b.deadline||'Flexible deadline'}</span><div className="brief-actions"><button className="btn btn-ghost btn-sm" onClick={onView}>Details</button>{onEdit&&<button className="btn btn-ghost btn-sm" onClick={onEdit}><Edit3 size={13}/></button>}{onReview&&<button className="btn btn-ghost btn-sm" onClick={onReview}>Applications</button>}{b.status==='Published'&&<button className="btn btn-primary btn-sm" onClick={onApply}>Apply <ArrowUpRight size={13}/></button>}</div></div></article>}

createRoot(document.getElementById('root')).render(<App/>);
